{
  "name": "mgrs-map-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "desktop": "electron .",
    "build:desktop": "vite build --base=./ && electron-builder --linux AppImage"
  },
  "dependencies": {
    "maplibre-gl": "^5.7.3",
    "mgrs": "^2.1.0"
  },
  "devDependencies": {
    "vite": "^7.1.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "dev.purnell.mgrs-viewer",
    "productName": "MGRS Viewer",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "MGRS-Viewer-${version}-linux.${ext}",
      "icon": "electron/app-icon-512.png"
    },
    "icon": "electron/app-icon-512.png"
  }
}
