{
  "name": "mgrs-map-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "desktop": "electron .",
    "build:desktop": "VITE_API_BASE= vite build --base=./ && electron-builder --linux AppImage",
    "build:desktop:mac": "VITE_API_BASE= vite build --base=./ && electron-builder --mac --arm64 --x64 && bash infra/package-mac.sh",
    "test": "npm run test:search && npm run test:north && npm run test:scale && npm run test:letters",
    "test:search": "node electron/search-api.test.cjs",
    "test:north": "node src/north.test.cjs",
    "test:scale": "node src/scale.test.cjs",
    "test:letters": "node src/mgrs-letters.test.cjs",
    "prebuild:desktop": "npm test"
  },
  "dependencies": {
    "magvar": "^2.2.0",
    "maplibre-gl": "^5.7.3",
    "mgrs": "^2.1.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "dev.purnell.mgrs-viewer",
    "productName": "MGRS Viewer",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "MGRS-Viewer-${version}-linux.${ext}",
      "icon": "electron/app-icon-512.png"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "electron/app-icon-512.png",
      "identity": null,
      "artifactName": "MGRS-Viewer-${version}-mac-${arch}.${ext}"
    },
    "icon": "electron/app-icon-512.png",
    "beforePack": "./electron/before-pack.cjs"
  }
}
